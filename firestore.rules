rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Public read-only access for legislative data (state code, bills, legislators)
    match /legislatures/{stateCode} {
      allow read: if true;
      allow write: if isAdmin();

      match /legislation/{billId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /legislators/{memberId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Users collection: owner read/write, admin full access
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Configurations collection: public read, admin write
    match /configurations/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

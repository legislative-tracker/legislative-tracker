{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/server-firebase",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": ["node"]
  },
  "exclude": ["**/*.spec.ts", "**/*.test.ts"],
  "include": [
    "src/**/*.ts",
    "../../libs/server-firebase/**/*.ts",
    "../../libs/shared/**/*.ts"
  ]
}

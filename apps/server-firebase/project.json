{
  "name": "server-firebase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server-firebase/src",
  "projectType": "application",
  "tags": ["type:app", "domain:server"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/server-firebase"],
      "options": {
        "commands": [
          "mkdir -p dist/apps/server-firebase logs/firebase",
          "cp apps/server-firebase/package.json dist/apps/server-firebase/",
          "cp apps/server-firebase/.env* dist/apps/server-firebase/ 2>/dev/null || true",
          "cp apps/server-firebase/.secret* dist/apps/server-firebase/ 2>/dev/null || true",
          "npx esbuild apps/server-firebase/src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/apps/server-firebase/index.js"
        ],
        "parallel": false
      }
    },
    "serve": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "logs/firebase",
        "commands": [
          "npx esbuild ../../apps/server-firebase/src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=../../dist/apps/server-firebase/index.js --watch",
          "fuser -k 8085/tcp 8080/tcp 9099/tcp 5001/tcp || true; firebase emulators:start --config ../../firebase.json --project demo-legislative-tracker --only functions,pubsub,firestore,auth --import=../../emulator_data --export-on-exit=../../emulator_data"
        ],
        "parallel": true
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase emulators:export ./emulator_data --project demo-legislative-tracker --force"
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "passWithNoTests": true,
        "config": "./vitest.config.ts",
        "coverage.reportsDirectory": "../../coverage/apps/server-firebase"
      }
    },
    "test-emulator": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "fuser -k 8085/tcp 8080/tcp 9099/tcp 5001/tcp || true; firebase emulators:exec --config firebase.json --project demo-legislative-tracker 'npx vitest run -c apps/server-firebase/vitest.config.ts'"
      }
    }
  }
}

{
  "name": "server-firebase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server-firebase/src",
  "projectType": "application",
  "tags": ["type:app", "domain:server"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/server-firebase"],
      "options": {
        "commands": [
          "mkdir -p dist/apps/server-firebase",
          "cp apps/server-firebase/package.json dist/apps/server-firebase/",
          "npx esbuild apps/server-firebase/src/index.ts --bundle --platform=node --target=node22 --packages=external --outfile=dist/apps/server-firebase/index.js"
        ],
        "parallel": false
      }
    },
    "serve": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx esbuild apps/server-firebase/src/index.ts --bundle --platform=node --target=node22 --packages=external --outfile=dist/apps/server-firebase/index.js --watch",
          "firebase emulators:start --only functions,pubsub,firestore"
        ],
        "parallel": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "configFile": "apps/server-firebase/vitest.config.ts",
        "passWithNoTests": true,
        "reportsDirectory": "coverage/apps/server-firebase"
      }
    }
  }
}

{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "apps/client-angular/src/main.ts",
    "apps/client-angular/src/backend.providers.firebase.ts",
    "apps/*/playwright.config.ts",
    "libs/**/src/index.ts",
    "scripts/**/*.js"
  ],
  "project": ["apps/**/*.{ts,js}", "libs/**/*.{ts,js}", "scripts/**/*.js"],
  "ignoreDependencies": [
    "@fortawesome/fontawesome-free",
    "@legislative-tracker/*",
    "@angular/cli",
    "@emnapi/core",
    "@emnapi/runtime",
    "@nx/devkit",
    "@nx/web",
    "@typescript-eslint/eslint-plugin",
    "firebase-admin",
    "firebase-functions",
    "firebase-functions-test",
    "graphql",
    "image-size",
    "typescript-eslint"
  ],
  "ignoreBinaries": ["firebase", "production"],
  "ignoreExportsUsedInFile": true,
  "ignoreUnresolved": ["apps/server-firebase/src/index.ts"]
}

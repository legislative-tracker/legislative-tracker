{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@legislative-tracker/shared/models": ["libs/shared/models/src/index.ts"],
      "@legislative-tracker/shared/util": ["libs/shared/util/src/index.ts"],
      "@legislative-tracker/shared/api-types": [
        "libs/shared/api-types/src/index.ts"
      ],
      "@legislative-tracker/client-angular/core": [
        "libs/client-angular/core/src/index.ts"
      ],
      "@legislative-tracker/client-angular/ui": [
        "libs/client-angular/ui/src/index.ts"
      ],
      "@legislative-tracker/client-angular/features": [
        "libs/client-angular/features/src/index.ts"
      ],
      "@legislative-tracker/server-firebase/data-access": [
        "libs/server-firebase/data-access/src/index.ts"
      ],
      "@legislative-tracker/server-firebase/functions": [
        "libs/server-firebase/functions/src/index.ts"
      ],
      "@app-models/*": ["libs/shared/models/src/lib/*"],
      "@app-core/*": ["libs/client-angular/core/src/lib/*"],
      "@app-shared/*": ["libs/client-angular/ui/src/lib/*"],
      "@app-features/*": ["libs/client-angular/features/src/lib/*"],
      "@app-pages/*": ["libs/client-angular/features/src/lib/pages/*"],
      "@app-admin/*": ["libs/client-angular/features/src/lib/admin/*"]
    }
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts"],
  "exclude": ["node_modules", "dist", "tmp"]
}

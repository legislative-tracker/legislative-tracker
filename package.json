{
  "name": "@legislative-tracker/source",
  "version": "0.11.5",
  "description": "Nx Monorepo for Legislative Tracker PWA and Firebase Server",
  "license": "AGPL-3.0-only",
  "author": "jpelton-stroud",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "nx": "nx",
    "start": "nx serve client-angular -c firebase",
    "build": "nx run-many -t build",
    "build:client": "nx build client-angular -c firebase",
    "build:server": "nx build server-firebase",
    "serve:client": "nx serve client-angular -c firebase",
    "serve:server": "fuser -k 8085/tcp 8080/tcp 9099/tcp 5001/tcp || true; nx serve server-firebase",
    "export:server": "nx export server-firebase",
    "test": "nx run-many -t test --watch=false",
    "test:client": "nx test client-angular",
    "test:server": "nx test server-firebase",
    "test:emulator": "nx test-emulator server-firebase",
    "test:e2e": "npx nx run-many -t e2e --parallel=1",
    "e2e": "npx nx run-many -t e2e --parallel=1",
    "lint": "nx run-many -t lint",
    "format": "prettier --write \"**/*.{ts,js,json,html,scss,md}\"",
    "knip": "knip",
    "release": "nx release",
    "sync-version": "node scripts/sync-version.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/cdk": "22.1.2",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/material": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/router": "22.1.2",
    "@angular/service-worker": "22.1.2",
    "@material/material-color-utilities": "^0.4.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.3",
    "graphql": "^16.12.0",
    "idb": "^8.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.1",
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.2",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^20.3.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@jpstroud/nys-openlegislation-types": "^1.0.1",
    "@jpstroud/opencivicdata-types": "^1.0.3",
    "@nx/angular": "23.1.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "^23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@playwright/test": "^1.62.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.47",
    "@swc/helpers": "0.5.23",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "firebase-functions-test": "^3.4.1",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "jiti": "2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "nx": "23.1.1",
    "popolo-types": "^0.2.1",
    "prettier": "^3.7.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0",
    "verdaccio": "6.9.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "apps/*",
    "libs/*/*"
  ],
  "overrides": {
    "brace-expansion": "^5.0.9",
    "ts-deepmerge": "^8.0.0",
    "uuid": "^11.1.1"
  },
  "nx": {
    "includedScripts": []
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "less@4.5.1": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true,
    "nx@23.1.1": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true,
    "@swc/core@1.15.47": true
  }
}
